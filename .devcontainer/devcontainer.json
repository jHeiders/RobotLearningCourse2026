{
    // Development container for the Meta-World multi-task RL project.
    //
    // Its job is environment parity across the group: one member may be on Windows,
    // where native Python would use `spawn` rather than `fork` for multiprocessing and
    // change how the vectorised environments behave. Inside this container everyone
    // gets Linux semantics and the same GL libraries.
    //
    // It doubles as the reproducibility artifact for the submitted code.
    "name": "Robot Learning - Meta-World MTRL",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "dev",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "runArgs": [
        "--name=meta-world-mtrl"
    ],
    // MuJoCo's "human" render mode needs a real X server. Instead of running one inside
    // the container, the host's display socket is passed in, so `--render` opens an
    // ordinary window on your own desktop. Assumes a Linux host with a graphical session,
    // which both of ours are; on a machine with no display only `--render` is affected.
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    // Runs on the host before the container starts, so nobody has to type it: allows
    // processes owned by your uid to use your X server. The container user has that same
    // uid (see updateRemoteUserUID below), so this covers it. Most desktops already allow
    // it and the command is then a no-op; "|| true" keeps a host without xhost — or
    // without a display at all — from blocking the container from starting.
    "initializeCommand": "xhost +SI:localuser:$(id -un) > /dev/null 2>&1 || true",
    "remoteUser": "dev",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    // "optional" so the container still starts on a machine without an NVIDIA GPU.
    // CPU-only training works: the bottleneck is MuJoCo stepping, not the network.
    "hostRequirements": {
        "gpu": "optional"
    },
    // Remap the container user to the host's uid/gid so files created on the bind
    // mount are owned correctly. Default true on Linux; stated explicitly because this
    // project is developed on a domain-joined machine where the host uid is nowhere
    // near 1000. No-op on Windows, where bind mounts carry no Unix ownership.
    "updateRemoteUserUID": true,
    "remoteEnv": {
        // Set these on the host and they pass through. Without them runs stay local;
        // without WANDB_ENTITY they land in your personal account rather than the
        // shared team, where your partner cannot see them.
        "WANDB_API_KEY": "${localEnv:WANDB_API_KEY}",
        "WANDB_ENTITY": "${localEnv:WANDB_ENTITY}",
        // Overrides the Dockerfile's MUJOCO_GL=egl, which is offscreen-only and cannot
        // open the window "human" mode asks for. The image keeps egl as its default so it
        // still runs headless somewhere without a display, e.g. a cluster node.
        "MUJOCO_GL": "glfw",
        // Which display the viewer opens on — your host's. Passed through verbatim
        // because devcontainer.json cannot express a default of ":0": its substitution
        // splits the expression on ":", so the ":0" would arrive mangled.
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    "postCreateCommand": "uv sync --all-extras",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-toolsai.tensorboard"
            ],
            "settings": {
                // Must match UV_PROJECT_ENVIRONMENT in the Dockerfile: the virtualenv
                // lives in the bind-mounted workspace, not in the user's home.
                "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
                "python.testing.pytestEnabled": true
            }
        }
    }
}

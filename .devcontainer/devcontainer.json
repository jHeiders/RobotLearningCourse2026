{
    // Development container for the Meta-World multi-task RL project.
    //
    // Its job is environment parity across the group: one member may be on Windows,
    // where native Python would use `spawn` rather than `fork` for multiprocessing and
    // change how the vectorised environments behave. Inside this container everyone
    // gets Linux semantics and the same GL libraries.
    //
    // It doubles as the reproducibility artifact for the submitted code.
    "name": "Robot Learning - Meta-World MTRL",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "dev",
            "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    "runArgs": [
        "--name=meta-world-mtrl"
    ],
    "remoteUser": "dev",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace",
    // "optional" so the container still starts on a machine without an NVIDIA GPU.
    // CPU-only training works: the bottleneck is MuJoCo stepping, not the network.
    "hostRequirements": {
        "gpu": "optional"
    },
    // Remap the container user to the host's uid/gid so files created on the bind
    // mount are owned correctly. Default true on Linux; stated explicitly because this
    // project is developed on a domain-joined machine where the host uid is nowhere
    // near 1000. No-op on Windows, where bind mounts carry no Unix ownership.
    "updateRemoteUserUID": true,
    "remoteEnv": {
        // Set these on the host and they pass through. Without them runs stay local;
        // without WANDB_ENTITY they land in your personal account rather than the
        // shared team, where your partner cannot see them.
        "WANDB_API_KEY": "${localEnv:WANDB_API_KEY}",
        "WANDB_ENTITY": "${localEnv:WANDB_ENTITY}"
    },
    "postCreateCommand": "uv sync --all-extras",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "ms-toolsai.tensorboard"
            ],
            "settings": {
                // Must match UV_PROJECT_ENVIRONMENT in the Dockerfile: the virtualenv
                // lives in the bind-mounted workspace, not in the user's home.
                "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
                "python.testing.pytestEnabled": true
            }
        }
    }
}
